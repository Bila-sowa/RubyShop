{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "checkJs": false,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["src/frontend/*"],
      "#shared/*": ["src/shared/*"],
      "#backend/*": ["src/backend/*"]
    }
  },
  "include": ["src", "prisma", "*.js"],
  "exclude": ["node_modules", "dist"]
}
